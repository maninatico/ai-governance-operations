    {
      "alwaysOutputData": true,
      "id": "ca84d-reg",
      "name": "CA84d_Registrar",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ $('CA84d_Disparador').first().json.comprobante_id ] }}"
        },
        "query": "-- Registra la factura que pasó todos los controles (L2: permitir con revisión posterior).\nUPDATE negocio.comprobantes SET estado = 'Registrada', fecha_registro = greatest(current_date, fecha_recepcion)\nWHERE comprobante_id = $1 AND estado = 'Recibida'\nRETURNING comprobante_id, total, estado;\n"
      },
      "position": [
        1340,
        80
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
