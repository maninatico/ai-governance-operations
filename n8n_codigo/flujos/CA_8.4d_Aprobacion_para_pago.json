    {
      "id": "ca84d-dap",
      "name": "CA84d_Datos_aprobacion",
      "parameters": {
        "jsCode": "const e = $('CA84d_Disparador').first().json;\nconst r = $input.first().json;   // fila registrada: el monto sale de la base, no del documento\nconst d = e.datos || {};\nreturn [{ json: { modo: 'pedir', automatizacion_id: 'A07', objeto: r.comprobante_id, accion: 'aprobar_pago', monto: r.total,\n  motivo: `${d.tipo || 'Comprobante'} ${d.punto_venta || ''}-${d.numero || ''} del proveedor ${e.proveedor_id}: pasó lectura, validación y CBU` } }];"
      },
      "position": [
        1780,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "ca84d-ped",
      "name": "CA84d_Pedir_aprobacion",
      "notes": "Motor de políticas: aprobar_pago (L3). Más de $ 5.000.000: doble control. Devuelve el link al formulario.",
      "parameters": {
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        },
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "NHCxpMVGzqr0HxGv"
        },
        "workflowInputs": {
          "attemptToConvertTypes": false,
