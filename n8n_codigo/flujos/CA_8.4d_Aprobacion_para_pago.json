    {
      "id": "ca84d-rped",
      "name": "CA84d_Resultado_pedir",
      "parameters": {
        "jsCode": "const e = $('CA84d_Disparador').first().json;\nlet estado, aprobacion = null, motivo = null;\nif (!$('CA84d_Politica_registro').isExecuted) { estado = 'No corresponde'; motivo = 'La factura no pasó todos los controles (8.4b o 8.4c)'; }\nelse if (!$('CA84d_Politica_registro').first().json.permitido) { estado = e.estado; motivo = 'El Motor de políticas no permite registrar'; }\nelse if (!$('CA84d_Pedir_aprobacion').isExecuted) { estado = e.estado; motivo = 'No se registró: el comprobante no estaba en estado Recibida'; }\nelse { estado = 'Registrada'; aprobacion = $('CA84d_Pedir_aprobacion').first().json; }\nreturn [{ json: { modo: 'pedir', comprobante_id: e.comprobante_id, proveedor_id: e.proveedor_id, estado, motivo,\n  aprobacion_id: aprobacion && aprobacion.aprobacion_id, nivel: aprobacion && aprobacion.nivel,\n  aprobador: aprobacion && aprobacion.aprobador, segundo_aprobador: aprobacion && aprobacion.segundo_aprobador,\n  vence: aprobacion && aprobacion.vence, link_formulario: aprobacion && aprobacion.link_formulario } }];"
      },
      "position": [
        2220,
        240
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "alwaysOutputData": true,
      "id": "ca84d-act",
      "name": "CA84d_Actualizar",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ String($json.prefijo || '') ] }}"
        },
        "query": "-- Pasa a la factura lo que decidieron las personas en el formulario. Solo mira aprobaciones de pago ya decididas.\nWITH ult AS (   -- la última aprobación de pago de cada factura registrada\n  SELECT DISTINCT ON (a.objeto) a.objeto, a.aprobacion_id, a.decision, a.motivo\n  FROM control.aprobaciones a JOIN negocio.comprobantes c ON c.comprobante_id = a.objeto\n  WHERE a.accion = 'aprobar_pago' AND c.estado = 'Registrada'\n    AND ($1 = '' OR a.objeto LIKE $1 || '%')\n  ORDER BY a.objeto, a.aprobacion_id DESC),\nupd AS (\n  UPDATE negocio.comprobantes c\n  SET estado = CASE ult.decision WHEN 'aprobado' THEN 'Aprobada para pago' ELSE 'En espera' END\n  FROM ult WHERE c.comprobante_id = ult.objeto AND ult.decision IS NOT NULL\n  RETURNING c.comprobante_id, c.estado, ult.aprobacion_id, ult.motivo),\ncola AS (\n  INSERT INTO control.cola_revision (origen, automatizacion_id, documento_id, motivo, prioridad)\n  SELECT 'facturas', 'A07', comprobante_id, 'Pago rechazado en la aprobación ' || aprobacion_id || ': ' || coalesce(motivo, 'sin motivo'), 'media'\n  FROM upd WHERE estado = 'En espera')\nSELECT comprobante_id, estado, aprobacion_id FROM upd\nUNION ALL\nSELECT objeto, 'Registrada (esperando decisión)', aprobacion_id FROM ult WHERE decision IS NULL\nORDER BY 1;\n"
      },
      "position": [
        460,
        520
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "ca84d-ract",
      "name": "CA84d_Resultado_actualizar",
      "parameters": {
        "jsCode": "const filas = $input.all().map((i) => i.json).filter((r) => r.comprobante_id);\nreturn [{ json: { modo: 'actualizar', cambios: filas.filter((r) => !r.estado.startsWith('Registrada')),\n  pendientes: filas.filter((r) => r.estado.startsWith('Registrada')).map((r) => r.comprobante_id) } }];"
      },
      "position": [
        680,
        520
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "ca84d-d81",
      "name": "CA84d_Datos_para_8.1",
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst doc = r.modo === 'pedir' ? r.comprobante_id : 'actualizar aprobaciones';\nconst motivo = r.modo === 'pedir' ? (r.aprobacion_id ? `Aprobación ${r.aprobacion_id} pedida (${r.nivel}) a ${r.aprobador}` : (r.motivo || ''))\n  : `${r.cambios.length} facturas actualizadas, ${r.pendientes.length} esperando decisión`;\nreturn [{ json: { modo: 'fin', automatizacion_id: 'A07', documento_id: doc, estado: 'ok', intervencion_humana: false,\n  modelo_ia: '', auditar: false, actor: 'A07', accion: 'aprobación para pago', motivo, respuesta: r } }];"
      },
      "position": [
        2440,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
