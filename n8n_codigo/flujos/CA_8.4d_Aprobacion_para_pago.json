{
  "name": "CA_8.4d_Aprobacion_para_pago",
  "nodes": [
    {
      "id": "ca84d-trigger",
      "name": "CA84d_Disparador",
      "notes": "A07 Aprobación para pago (L3). Sin IA. Modo 'pedir': entrada = salida del 8.4c; registra la factura (L2) y pide la aprobación al 8.3. Modo 'actualizar' (prefijo opcional): pasa a la factura lo decidido en el formulario. El silencio nunca aprueba.",
