    {
      "id": "ca84d-modo",
      "name": "CA84d_Modo",
      "parameters": {
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "modo_invalido"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r-pedir",
                    "leftValue": "={{ $json.modo }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "pedir"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                }
              },
              "outputKey": "pedir",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r-actualizar",
                    "leftValue": "={{ $json.modo }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "actualizar"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                }
              },
              "outputKey": "actualizar",
              "renameOutput": true
            }
          ]
        }
      },
      "position": [
        220,
        400
      ],
      "type": "n8n-nodes-base.switch",
