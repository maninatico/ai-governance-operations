    {
      "alwaysOutputData": true,
      "id": "ca85b-der",
      "name": "CA85b_Derivar",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ $('CA85b_Disparador').first().json.reclamo_id ] }}"
        },
        "query": "-- Deriva según la tabla fija categoría -> área y fija los vencimientos en horas hábiles. No pisa una derivación previa.\nUPDATE negocio.reclamos r\nSET area_derivada = a.area,\n    vence_primera_respuesta = control.sumar_horas_habiles(r.fecha_hora_ingreso, 24),\n    vence_resolucion        = control.sumar_horas_habiles(r.fecha_hora_ingreso, 45)\nFROM negocio.areas_por_categoria a\nWHERE r.reclamo_id = $1 AND a.categoria = r.categoria AND r.area_derivada IS NULL\nRETURNING r.reclamo_id, r.categoria, r.area_derivada,\n          to_char(r.vence_primera_respuesta, 'YYYY-MM-DD HH24:MI') AS vence_primera_respuesta,\n          to_char(r.vence_resolucion, 'YYYY-MM-DD HH24:MI') AS vence_resolucion;\n"
      },
      "position": [
        1340,
        80
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "ca85b-rder",
      "name": "CA85b_Resultado_derivar",
      "parameters": {
        "jsCode": "const e = $('CA85b_Disparador').first().json;\nlet estado, motivo = null, d = {};\nif (!$('CA85b_Politica').isExecuted) { estado = 'No corresponde'; motivo = 'El reclamo no quedó clasificado (ver la cola)'; }\nelse if (!$('CA85b_Politica').first().json.permitido) { estado = 'No derivado'; motivo = 'El Motor de políticas no permite derivar'; }\nelse { d = $('CA85b_Derivar').first().json; estado = d.reclamo_id ? 'derivado' : 'Ya derivado antes'; }\nreturn [{ json: { modo: 'derivar', reclamo_id: e.reclamo_id, estado, motivo, categoria: d.categoria || e.categoria || null,\n  area: d.area_derivada || null, vence_primera_respuesta: d.vence_primera_respuesta || null, vence_resolucion: d.vence_resolucion || null } }];"
      },
      "position": [
        1560,
        240
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "alwaysOutputData": true,
      "id": "ca85b-seg",
      "name": "CA85b_Seguimiento",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ String($json.ahora || ''), String($json.prefijo || '') ] }}"
        },
        "query": "-- Seguimiento de plazos. Parámetros: hora de referencia (vacía = ahora) y prefijo (vacío = reclamos reales).\n-- Aviso a las 16 horas hábiles sin primera respuesta; a las 24, se escala al Jefe de Atención por la cola.\nWITH p AS (SELECT coalesce(nullif($1, '')::timestamp, now()::timestamp) AS ahora, $2::text AS prefijo),\npend AS (\n  SELECT r.reclamo_id, r.area_derivada, r.fecha_hora_ingreso, r.vence_primera_respuesta, r.aviso_enviado, r.escalado,\n         control.sumar_horas_habiles(r.fecha_hora_ingreso, 16) AS aviso_desde, p.ahora\n  FROM negocio.reclamos r, p\n  WHERE r.fecha_hora_primera_respuesta IS NULL AND r.area_derivada IS NOT NULL\n    AND r.fecha_hora_ingreso <= p.ahora\n    AND (CASE WHEN p.prefijo = '' THEN r.reclamo_id NOT LIKE 'PRUEBA%' ELSE r.reclamo_id LIKE p.prefijo || '%' END)),\nesc AS (\n  UPDATE negocio.reclamos r SET escalado = true, aviso_enviado = true\n  FROM pend WHERE r.reclamo_id = pend.reclamo_id AND NOT pend.escalado AND pend.ahora >= pend.vence_primera_respuesta\n  RETURNING r.reclamo_id),\ncola AS (\n  INSERT INTO control.cola_revision (origen, automatizacion_id, documento_id, motivo, prioridad, asignado_a)\n  SELECT 'reclamos', 'A09', pend.reclamo_id,\n         'Sin primera respuesta en 24 horas hábiles (venció ' || to_char(pend.vence_primera_respuesta, 'DD/MM HH24:MI') || '). Área: ' || pend.area_derivada,\n         'alta', 'Jefe de Atención'\n  FROM esc JOIN pend USING (reclamo_id)),\navi AS (\n  UPDATE negocio.reclamos r SET aviso_enviado = true\n  FROM pend WHERE r.reclamo_id = pend.reclamo_id AND NOT pend.aviso_enviado\n    AND pend.ahora >= pend.aviso_desde AND pend.ahora < pend.vence_primera_respuesta\n  RETURNING r.reclamo_id)\nSELECT pend.reclamo_id, pend.area_derivada,\n       CASE WHEN esc.reclamo_id IS NOT NULL THEN 'escalado' ELSE 'aviso' END AS accion,\n       to_char(pend.vence_primera_respuesta, 'YYYY-MM-DD HH24:MI') AS vence_primera_respuesta\nFROM pend LEFT JOIN esc USING (reclamo_id) LEFT JOIN avi USING (reclamo_id)\nWHERE esc.reclamo_id IS NOT NULL OR avi.reclamo_id IS NOT NULL\nORDER BY 1;\n"
      },
      "position": [
        460,
        560
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "ca85b-rseg",
      "name": "CA85b_Resultado_seguimiento",
      "parameters": {
        "jsCode": "const filas = $input.all().map((i) => i.json).filter((r) => r.reclamo_id);\nreturn [{ json: { modo: 'seguimiento', avisos: filas.filter((r) => r.accion === 'aviso'), escalados: filas.filter((r) => r.accion === 'escalado') } }];"
      },
      "position": [
        680,
        560
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "ca85b-d81",
      "name": "CA85b_Datos_para_8.1",
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst doc = r.modo === 'derivar' ? r.reclamo_id : 'seguimiento de plazos';\nconst motivo = r.modo === 'derivar' ? (r.area ? `Derivado a ${r.area}; primera respuesta hasta ${r.vence_primera_respuesta}` : (r.motivo || r.estado))\n  : `${r.avisos.length} avisos, ${r.escalados.length} escalados al Jefe de Atención`;\nreturn [{ json: { modo: 'fin', automatizacion_id: 'A09', documento_id: doc, estado: (r.modo === 'seguimiento' && r.escalados.length) ? 'derivado_a_cola' : 'ok',\n  intervencion_humana: false, modelo_ia: '', auditar: false, actor: 'A09', accion: 'derivación y plazos', motivo, respuesta: r } }];"
      },
      "position": [
        1780,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
