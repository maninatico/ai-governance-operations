    {
      "id": "r10",
      "name": "CA85_Ordenar",
      "parameters": {
        "jsCode": "// Bandeja de reclamos (lote de octubre): CSV con comillas y comas en el texto. Se quita el BOM y se ordena por ingreso.\nconst p = $('CA85_Parametros').first().json;\nlet txt = String($input.first().json.data || '').replace(/^﻿/, '');\nconst filas = []; let fila = [], campo = '', comillas = false;\nfor (let i = 0; i < txt.length; i++) {\n  const ch = txt[i];\n  if (comillas) {\n    if (ch === '\"' && txt[i + 1] === '\"') { campo += '\"'; i++; }\n    else if (ch === '\"') comillas = false;\n    else campo += ch;\n  } else if (ch === '\"') comillas = true;\n  else if (ch === ',') { fila.push(campo); campo = ''; }\n  else if (ch === '\\n' || ch === '\\r') { if (ch === '\\r' && txt[i + 1] === '\\n') i++; fila.push(campo); filas.push(fila); fila = []; campo = ''; }\n  else campo += ch;\n}\nif (campo !== '' || fila.length) { fila.push(campo); filas.push(fila); }\nconst cab = filas.shift().map((c) => c.trim());\nlet correos = filas.filter((f) => f.length === cab.length).map((f) => Object.fromEntries(cab.map((c, k) => [c, f[k]])));\ncorreos.sort((a, b) => a.fecha_hora_ingreso.localeCompare(b.fecha_hora_ingreso) || a.reclamo_id.localeCompare(b.reclamo_id));\nif (p.limite > 0) correos = correos.slice(0, p.limite);\nreturn correos.map((c) => ({ json: c }));\n"
      },
      "position": [
        1760,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
