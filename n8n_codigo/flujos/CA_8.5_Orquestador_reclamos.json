    {
      "id": "r19",
      "name": "CA85_Fin_reclamo",
      "parameters": {
        "jsCode": "// Una fila por reclamo: hasta dónde llegó y en qué estado quedó.\nconst c = $('CA85_Por_reclamo').first().json;\nconst r = $input.first().json;\nconst err = r.error ? (r.error.message || String(r.error)) : null;\nreturn [{ json: { reclamo_id: c.reclamo_id, canal: c.canal, estado: err ? 'error' : (r.estado || 'sin estado'),\n  area: r.area || null, link_formulario_en_borrador: /\\[LINK_FORMULARIO\\]/.test(r.borrador || ''),\n  motivos: (r.motivos || []).join ? (r.motivos || []).join('; ') : (r.motivo || null), error: err } }];"
      },
      "position": [
        3740,
        440
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "r20",
      "name": "CA85_Resumen_reclamos",
      "parameters": {
        "jsCode": "const filas = $input.all().map((i) => i.json);\nconst por = {}; for (const f of filas) por[f.estado] = (por[f.estado] || 0) + 1;\nreturn [{ json: { reclamos: filas.length, por_estado: por,\n  borradores_con_link_al_formulario: filas.filter((f) => f.link_formulario_en_borrador).length,\n  errores: filas.filter((f) => f.estado === 'error') } }, ...filas.map((f) => ({ json: f }))];"
      },
