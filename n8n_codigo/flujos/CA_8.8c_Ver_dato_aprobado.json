      "name": "CA88CV_Ver",
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ String(Math.trunc(Number($('CA88CV_Formulario').first().json['Número de solicitud']))), String($('CA88CV_Formulario').first().json['Quién pidió']) ] }}"
        },
        "query": "SELECT * FROM boveda.ver_dato_aprobado($1::bigint, $2);"
      },
      "position": [
        660,
        200
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "v5",
      "name": "CA88CV_Fin_entregado",
      "parameters": {
        "completionMessage": "={{ (() => { const e = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); return 'Documento: ' + e($json.o_documento) + '<br>Marcador: ' + e($json.o_marcador) + ' (' + e($json.o_tipo) + ')<br><br><b>Dato real: ' + e($json.o_valor) + '</b><br><br>Copialo ahora: no se vuelve a mostrar. Quedó registrado quién lo vio, cuándo y con qué aprobación. El valor no se guarda en la auditoría.'; })() }}",
        "completionTitle": "Dato aprobado",
