        "query": "INSERT INTO boveda.marcadores (documento_id, marcador, tipo, valor_real)\nSELECT $1, x->>'marcador', x->>'tipo', x->>'valor'\nFROM jsonb_array_elements($2::jsonb) AS x\nON CONFLICT (documento_id, marcador) DO NOTHING;"
