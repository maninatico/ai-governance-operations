        "jsCode": "return [\n  { json: { doc: 'PRUEBA-LOTE-1', romper: false } },\n  { json: { doc: 'PRUEBA-LOTE-2', romper: true } },\n  { json: { doc: 'PRUEBA-LOTE-3', romper: false } },\n];"
