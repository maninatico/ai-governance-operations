    {
      "id": "o10",
      "name": "CA84_Ordenar",
      "parameters": {
        "jsCode": "// Buzón simulado: CSV con comillas y comas dentro del cuerpo. Se quita el BOM y se ordena por llegada.\nconst p = $('CA84_Parametros').first().json;\nlet txt = String($input.first().json.data || '').replace(/^﻿/, '');\nconst filas = []; let fila = [], campo = '', comillas = false;\nfor (let i = 0; i < txt.length; i++) {\n  const ch = txt[i];\n  if (comillas) {\n    if (ch === '\"' && txt[i + 1] === '\"') { campo += '\"'; i++; }\n    else if (ch === '\"') comillas = false;\n    else campo += ch;\n  } else if (ch === '\"') comillas = true;\n  else if (ch === ',') { fila.push(campo); campo = ''; }\n  else if (ch === '\\n' || ch === '\\r') { if (ch === '\\r' && txt[i + 1] === '\\n') i++; fila.push(campo); filas.push(fila); fila = []; campo = ''; }\n  else campo += ch;\n}\nif (campo !== '' || fila.length) { fila.push(campo); filas.push(fila); }\nconst cab = filas.shift().map((c) => c.trim());\nlet correos = filas.filter((f) => f.length === cab.length).map((f) => Object.fromEntries(cab.map((c, k) => [c, f[k]])));\ncorreos.sort((a, b) => a.fecha_hora.localeCompare(b.fecha_hora) || a.correo_id.localeCompare(b.correo_id));\nif (p.limite > 0) correos = correos.slice(0, p.limite);\nreturn correos.map((c) => ({ json: c }));\n"
      },
      "position": [
        1760,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
