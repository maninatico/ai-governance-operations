    {
      "id": "o20",
      "name": "CA84_Fin_correo",
      "parameters": {
        "jsCode": "// Una fila por correo: hasta dónde llegó y en qué estado quedó.\nconst c = $('CA84_Por_correo').first().json;\nconst r = $input.first().json;\nconst err = r.error ? (r.error.message || String(r.error)) : null;\nreturn [{ json: { correo_id: c.correo_id, adjunto: c.adjunto, fecha_hora: c.fecha_hora,\n  estado: err ? 'error' : (r.estado || 'sin estado'), comprobante_id: r.comprobante_id || null,\n  aprobacion_id: r.aprobacion_id || null, nivel: r.nivel || null, error: err } }];"
      },
      "position": [
        3960,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "o21",
      "name": "CA84_Resumen",
      "parameters": {
        "jsCode": "const filas = $input.all().map((i) => i.json);\nconst por = {}; for (const f of filas) por[f.estado] = (por[f.estado] || 0) + 1;\nreturn [{ json: { correos: filas.length, por_estado: por, errores: filas.filter((f) => f.estado === 'error') } },\n  ...filas.map((f) => ({ json: f }))];"
      },
      "position": [
        2200,
