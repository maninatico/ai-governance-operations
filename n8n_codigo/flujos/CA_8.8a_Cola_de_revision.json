    {
      "id": "ca88a-pag2",
      "name": "CA88A_Detalle_y_decision",
      "parameters": {
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decisión",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Es duplicada"
                  },
                  {
                    "option": "No es duplicada"
                  },
                  {
                    "option": "Registrar con dato verificado"
                  },
                  {
                    "option": "Dejar en espera"
                  },
                  {
                    "option": "Asignar cliente"
                  },
                  {
                    "option": "Seguir sin identificar"
                  },
                  {
                    "option": "Pasar a redacción manual"
                  },
                  {
                    "option": "Confirmar derivación al Responsable"
                  },
                  {
                    "option": "Ataque confirmado"
                  },
                  {
                    "option": "Falsa alarma"
                  }
                ]
              },
              "fieldType": "dropdown",
              "requiredField": true
            },
            {
              "fieldLabel": "Motivo",
              "fieldType": "textarea",
              "placeholder": "Qué verificaste y contra qué. Para Registrar con dato verificado, mínimo 15 caracteres.",
              "requiredField": true
            },
            {
              "fieldLabel": "Cliente a asignar",
              "fieldType": "text",
              "placeholder": "Solo para Asignar cliente: el cliente_id",
              "requiredField": false
            }
          ]
        },
        "operation": "page",
        "options": {
          "buttonLabel": "Registrar decisión",
          "formDescription": "={{ (() => { const e = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); return '<b>' + e($json.o_origen) + ' · ' + e($json.o_automatizacion) + '</b><br>Documento: ' + e($json.o_documento) + '<br>Motivo: ' + e($json.o_motivo) + '<br><br>' + e($json.o_contexto) + '<br><br>Decisiones válidas para este caso: <b>' + e($json.o_decisiones) + '</b><br>Casos esperando: ' + e($json.o_pendientes) + '<br>Decide: <b>' + e($('CA88A_Formulario').first().json['Quién decide']) + '</b>'; })() }}",
          "formTitle": "=Caso N.º {{ $json.o_caso_id }} ({{ $json.o_prioridad }})"
        }
      },
      "position": [
        1100,
        100
      ],
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "webhookId": "6f1b7c0e-2a43-4d58-9a11-5c0b88a1c002"
    },
    {
      "id": "ca88a-reg",
      "name": "CA88A_Registrar_decision",
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ String($('CA88A_Siguiente').first().json.o_caso_id), String($('CA88A_Formulario').first().json['Quién decide']), String($json['Decisión']), String($json['Motivo'] ?? ''), String($json['Cliente a asignar'] ?? '') ] }}"
        },
        "query": "SELECT control.resolver_caso($1::bigint, $3, $2, $4, NULLIF($5, '')) AS mensaje;"
      },
      "position": [
        1320,
        100
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
