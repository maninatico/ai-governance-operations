              "fieldLabel": "Quién decide",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Analista CxP"
                  },
                  {
                    "option": "Agente de atención"
                  },
                  {
                    "option": "Jefe de Atención"
                  },
                  {
                    "option": "Responsable de Sistemas"
                  },
                  {
                    "option": "Analista de Procesos"
                  }
                ]
              },
              "fieldType": "dropdown",
              "requiredField": true
            }
          ]
        },
        "formTitle": "Materiales Cumbre Andina · Cola de revisión",
