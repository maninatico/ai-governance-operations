      "parameters": {
        "completionMessage": "={{ $json.mensaje }}<br>Quedó en la auditoría con quién, cuándo y por qué.<br>Casos que quedan esperando: {{ Math.max(0, Number($('CA88A_Siguiente').first().json.o_pendientes) - 1) }}. Volvé a abrir el formulario para ver el próximo.",
        "completionTitle": "Decisión registrada",
        "operation": "completion",
