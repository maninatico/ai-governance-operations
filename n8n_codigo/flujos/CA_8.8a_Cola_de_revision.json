      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "webhookId": "6f1b7c0e-2a43-4d58-9a11-5c0b88a1c001"
    },
    {
      "alwaysOutputData": true,
      "id": "ca88a-int",
      "name": "CA88A_Interruptores",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "SELECT (count(*) = 2 AND bool_and(activo)) AS encendido FROM control.interruptores WHERE flujo IN ('GENERAL', '8.8 Desenmascarador y cola');"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "ca88a-if1",
      "name": "CA88A_Encendido",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.encendido === true }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
